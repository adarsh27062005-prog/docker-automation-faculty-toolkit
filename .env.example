# Docker/GitHub Submission Viewer Configuration

# Cache expiration for Docker Hub responses (in seconds; default: 15 minutes)
CACHE_TTL_SECONDS=900

# Basis for calculating the official Submission Date:
# - last_push (default): Datetime of most recent tag push (max tag_last_pushed)
# - first_push: Datetime of earliest tag push (min tag_last_pushed)
# - created: Datetime when the repository was registered on Docker Hub
# Note: If a repository has no tags pushed, Submission Date is left blank with note 'No image pushed'.
SUBMISSION_DATE_BASIS=last_push

# Optional submission deadline (ISO format with timezone, e.g., 2026-07-01T23:59:59+05:30)
# If omitted or empty, the Status column (On time / Late) is hidden.
SUBMISSION_DEADLINE=

# Timezone for displaying timestamps in Excel exports (default: Asia/Kolkata for IST UTC+5:30)
DISPLAY_TZ=Asia/Kolkata

# Optional GitHub Personal Access Token for GitHub API metadata enrichment
# If omitted, GitHub API calls are skipped and the app functions normally.
GITHUB_TOKEN=

# Input data file paths
OVERRIDES_FILE=overrides.csv

# Upgrade 2: Roster upload & Job limits
# Maximum uploaded roster file size in megabytes (default: 2 MB)
MAX_UPLOAD_MB=2

# Maximum number of valid students in an uploaded roster (default: 500)
MAX_STUDENTS=500

# Roster in-memory retention in hours before eviction (default: 12 hours)
ROSTER_TTL_HOURS=12

# Maximum active rosters kept in memory (least recently used evicted; default: 50)
MAX_ROSTERS=50

# Export-all background job retention in hours (default: 2 hours)
JOB_TTL_HOURS=2

# GitHub README discovery flag:
# - false (default): Skip single repo detail calls; discovery from overrides and repo description only (faster).
# - true: Call single repo detail endpoint for EVERY repo to search full_description README (slower).
GITHUB_README_LOOKUP=false
